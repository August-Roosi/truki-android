<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:label="@string/truki_wear_app_name"
        tools:replace="android:label">

        <!-- Runs without a paired phone (LTE / Wi-Fi). -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <provider
            android:name=".truki.wear.TrukiWearInitProvider"
            android:authorities="${applicationId}.trukiwearinit"
            android:exported="false" />

        <!-- Declared before the alias below, which targets it. -->
        <activity
            android:name=".truki.wear.TrukiWearActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Truki.Wear" />

        <!--
          Upstream's launcher entry opens the watch UI instead of the phone UI.
          It must stay an enabled launcher activity: upstream publishes
          conversation shortcuts against it after every sent message, and
          Android rejects (and the app crashes on) shortcuts whose activity is
          not a main activity.
        -->
        <activity-alias
            android:name=".RoutingActivity"
            android:targetActivity=".truki.wear.TrukiWearActivity"
            tools:replace="android:targetActivity" />
    </application>
</manifest>
